# Susu Phone Agent — environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Phone Bridge ──────────────────────────────────────────────────────────────
# A secret token shared between the Bridge server and the Android APK.
# Generate with: openssl rand -hex 32
PHONE_BRIDGE_TOKEN=

# URL where your Phone Bridge is publicly accessible (HTTPS required for the APK)
BRIDGE_BASE_URL=https://your-domain.example/phone-bridge

# ── Sleep Guard (optional feature) ───────────────────────────────────────────
# Separate token for the Sleep Guard state endpoint.
# Can be the same as PHONE_BRIDGE_TOKEN or a different value.
SLEEP_GUARD_TOKEN=

# URL for the Sleep Guard state endpoint
SLEEP_GUARD_URL=https://your-domain.example/sleep-guard/state

# ── Phone Bridge server (bridge/bridge.py) ────────────────────────────────────
# Path to a file containing the PHONE_BRIDGE_TOKEN value (used by bridge.py)
PHONE_BRIDGE_TOKEN_PATH=/etc/susu-phone-agent/phone_bridge_token.txt

# ── Phone MCP server (mcp/phone_mcp.py) ──────────────────────────────────────
# URL of the Phone Bridge (localhost when MCP and Bridge run on the same host)
BRIDGE_URL=http://127.0.0.1:7070

# Path to the token file read by phone_mcp.py
TOKEN_PATH=/etc/susu-phone-agent/phone_bridge_token.txt
